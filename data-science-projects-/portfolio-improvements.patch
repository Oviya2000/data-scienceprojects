+      {label:'Attrition %', data: tr.rate.map(v=>(v*100).toFixed(1)),
+       backgroundColor: PBI.teal}]},
+    options:{maintainAspectRatio:false,plugins:{legend:{display:false},
+      tooltip:{callbacks:{label:ctx=>`${ctx.parsed.y}% (${tr.leav[ctx.dataIndex]} of ${tr.tot[ctx.dataIndex]})`}}},
+      scales:{y:{beginAtZero:true,ticks:{callback:v=>v+'%'}}}}
+  });
+}
+
+function render(){
+  paintSlicers(); renderKpis(); renderCharts();
+  document.getElementById('selection-status').textContent=filtered().length+' matching employees · synthetic snapshot · rates describe associations';
+  const dep=groupRate('Department'),body=document.getElementById('summary-rows');body.replaceChildren();
+  dep.labels.forEach((name,i)=>{const tr=document.createElement('tr');[name,dep.tot[i],dep.leav[i],(dep.rate[i]*100).toFixed(1)+'%'].forEach(value=>{const td=document.createElement('td');td.textContent=value;tr.append(td)});body.append(tr)});
+}
+
+document.getElementById('download').onclick=()=>{
+  const rows=filtered(),keys=Object.keys(DATA[0]);
+  const quote=v=>'"'+String(v).replaceAll('"','""')+'"';
+  const csv=[keys.map(quote).join(','),...rows.map(row=>keys.map(key=>quote(row[key])).join(','))].join('\r\n');
+  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.download='hr-filtered-synthetic.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);
+};
+// -------------------------- boot ---------------------------------------
+makeSlicer('Department','slicer-dept');
+makeSlicer('OverTime','slicer-ot');
+makeSlicer('Gender','slicer-gender');
+makeSlicer('BusinessTravel','slicer-travel');
+document.getElementById('reset').onclick = ()=>{
+  Object.keys(state).forEach(k=>state[k]=null); render();
+};
+render();
+</script>
